{
  "name": "litra-monorepo",
  "version": "0.0.4",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "litra",
    "litra-cli"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "tsc -b --clean && rm -rf .cache lib litra/lib litra-cli/lib",
    "package": "bun scripts/package.ts",
    "release": "bun scripts/release.ts"
  },
  "trustedDependencies": [
    "node-hid"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
