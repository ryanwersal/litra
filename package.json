{
  "name": "litra-monorepo",
  "version": "0.0.4",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "litra",
    "litra-cli"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "tsc -b --clean && rm -rf lib litra/lib litra-cli/lib",
    "release": "bun scripts/release.ts"
  },
  "trustedDependencies": [
    "node-hid"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
